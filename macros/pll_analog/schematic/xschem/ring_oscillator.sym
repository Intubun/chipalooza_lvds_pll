v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -62 -6 0 0 0.3 0.3 {}
T {@name} 105 -62 0 0 0.2 0.2 {}
P 4 5 100 -50 -100 -50 -100 70 100 70 100 -50 {}
B 5 -122.5 -32.5 -117.5 -27.5 {name=VCTRL dir=in}
L 4 -120 -30 -100 -30 {}
T {VCTRL} -95 -34 0 0 0.2 0.2 {}
B 5 117.5 -32.5 122.5 -27.5 {name=VCO_OUT dir=out}
L 4 100 -30 120 -30 {}
T {VCO_OUT} 95 -34 0 1 0.2 0.2 {}
B 5 117.5 -12.5 122.5 -7.5 {name=VDD dir=inout}
L 7 100 -10 120 -10 {}
T {VDD} 95 -14 0 1 0.2 0.2 {}
B 5 117.5 47.5 122.5 52.5 {name=VSS dir=inout}
L 7 100 50 120 50 {}
T {VSS} 95 46 0 1 0.2 0.2 {}
