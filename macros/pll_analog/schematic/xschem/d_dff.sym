v {xschem version=3.4.8RC file_version=1.3}
G {type=delay
verilog_ignore=true
vhdl_ignore=true
format="@name @@D @@CLK @@SET @@RESET @@Q @@QN @dff_model"
template="name=A1 dff_model=pll_dff"
}
L 4 -50 -50 50 -50 {}
L 4 50 -50 50 50 {}
L 4 50 50 -50 50 {}
L 4 -50 50 -50 -50 {}
B 5 -72.5 -32.5 -67.5 -27.5 {name=D dir=in}
L 4 -70 -30 -50 -30 {}
T {D} -45 -34 0 0 0.2 0.2 {}
B 5 -72.5 -12.5 -67.5 -7.5 {name=CLK dir=in}
L 4 -70 -10 -50 -10 {}
T {CLK} -45 -14 0 0 0.2 0.2 {}
B 5 -72.5 7.5 -67.5 12.5 {name=SET dir=in}
L 4 -70 10 -50 10 {}
T {S} -45 6 0 0 0.2 0.2 {}
B 5 -72.5 27.5 -67.5 32.5 {name=RESET dir=in}
L 4 -70 30 -50 30 {}
T {R} -45 26 0 0 0.2 0.2 {}
B 5 67.5 -22.5 72.5 -17.5 {name=Q dir=out}
L 4 50 -20 70 -20 {}
T {Q} 45 -24 0 1 0.2 0.2 {}
B 5 67.5 17.5 72.5 22.5 {name=QN dir=out}
L 4 50 20 70 20 {}
T {QN} 45 16 0 1 0.2 0.2 {}
T {@name} -45 -62 0 0 0.2 0.2 {}
