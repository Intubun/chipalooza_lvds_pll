# Set default PDK_ROOT
if { ![info exists env(PDK_ROOT)] } {
  puts stderr "Warning: PDK_ROOT env. var. not found or empty, trying to find an open_pdks install"
  if {[file isdir /usr/share/pdk]} {set ::env(PDK_ROOT) /usr/share/pdk
  } elseif {[file isdir /usr/local/share/pdk]} {set ::env(PDK_ROOT) /usr/local/share/pdk
  } elseif {[file isdir $env(HOME)/share/pdk]} {set ::env(PDK_ROOT) $env(HOME)/share/pdk
  } elseif {[file isdir $env(HOME)/.ciel]} {set ::env(PDK_ROOT) $env(HOME)/.ciel
  } elseif {[file isdir $env(HOME)/.volare]} {set ::env(PDK_ROOT) $env(HOME)/.volare
  } else {
    puts stderr {No open_pdks installation found, set PDK_ROOT env. var. and restart xschem}
  }
}

# Set default PDK
if { ![info exists env(PDK)] } {
  set ::env(PDK) ihp-sg13cmos5l
}

# Source the PDK xschemrc file
if {![info exists PDK]} {
    source $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
}

# Source top-level schematic xschemrc to pull in canonical library paths and macro libraries.
source [file normalize [file join [file dirname [info script]] ../../schematic/xschem/xschemrc]]

# Pin the netlist directory to the simulations folder of the loaded schematic
if {![llength [info commands pin_netlist_dir]]} {
  proc pin_netlist_dir {dir} {
    set dir [file normalize $dir]
    if {[string match */schematic/xschem $dir]} {
      set dir [file join $dir ../../testbenches/xschem]
    } elseif {![string match */testbenches/xschem $dir] && ![string match */cace/templates $dir]} {
      return
    }
    set ::netlist_dir [file normalize [file join $dir simulations]]
  }
}
pin_netlist_dir [file dirname [info script]]
set load_file_postprocess {pin_netlist_dir [xschem get current_dirname]}

# ngspice parses [ ] as XSPICE vector-node syntax, so a net called dig_in[0]
# comes back as "Unexpected [ - Arrays of arrays not allowed".  Let xschem
# rename bussed nets while it netlists: dig_in[0] -> dig_in_0_.  Doing it here
# rather than with sed afterwards means the arrow inside xschem and the Makefile
# produce the same netlist.  Deliberately not set in schematic/xschem/xschemrc -
# the design netlist keeps its brackets for LVS against the wrapper.
set bus_replacement_char {__}


# The top cell instantiates pll_cosim, so its PFD and dividers are the RTL of
# macros/pll_digital running under d_cosim.  ngspice only bridges that block to
# the analog loop if auto_bridge_d_in / auto_bridge_d_out are set before the
# circuit is parsed, and those two `pre_set` lines cannot live in the schematic:
# xschem carries an ngspice block as a value="..." property and the pre_set
# syntax needs double quotes of its own, which end the property early - the rest
# of the control block, .endc included, is dropped without a word.
#
# So the netlist is patched after xschem writes it.  make sim-xschem does that
# too; wiring it in here as well is what keeps the Simulate arrow inside xschem
# honest.  Without it the cosim block never couples, nothing moves, and every
# waveform comes out flat.
set XSCHEM_COSIM_INJECT [file normalize [file join [file dirname [info script]] .. .. scripts pll inject_cosim_bridges.py]]
foreach {_idx _run} {
  0 {ngspice -i "$N" -a}
  1 {ngspice "$N" -a}
  2 {ngspice -b -r "$n.raw" "$N"}
} {
  set sim(spice,$_idx,cmd) "$XSCHEM_COSIM_INJECT \"\$N\" ; $_run"
}
unset _idx _run
