v {xschem version=3.4.8RC file_version=1.3}
G {type=delay
verilog_ignore=true
vhdl_ignore=true
format="@name @@CLK @@OUT @divider_model"
template="name=A1 divider_model=pll_fdiv"
}
L 4 -40 -25 40 -25 {}
L 4 40 -25 40 25 {}
L 4 40 25 -40 25 {}
L 4 -40 25 -40 -25 {}
B 5 -62.5 -2.5 -57.5 2.5 {name=CLK dir=in}
L 4 -60 0 -40 0 {}
B 5 57.5 -2.5 62.5 2.5 {name=OUT dir=out}
L 4 40 0 60 0 {}
T {/N} -8 -6 0 0 0.3 0.3 {}
T {@name} -35 -38 0 0 0.2 0.2 {}
