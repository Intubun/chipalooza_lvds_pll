v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -42 -6 0 0 0.3 0.3 {}
T {@name} 65 -72 0 0 0.2 0.2 {}
P 4 5 60 -60 -60 -60 -60 60 60 60 60 -60 {}
B 5 -82.5 -32.5 -77.5 -27.5 {name=UP dir=in}
L 4 -80 -30 -60 -30 {}
T {UP} -55 -34 0 0 0.2 0.2 {}
B 5 -82.5 7.5 -77.5 12.5 {name=DOWN dir=in}
L 4 -80 10 -60 10 {}
T {DOWN} -55 6 0 0 0.2 0.2 {}
B 5 -82.5 37.5 -77.5 42.5 {name=IREF dir=inout}
L 4 -80 40 -60 40 {}
T {IREF} -55 36 0 0 0.2 0.2 {}
B 5 77.5 -2.5 82.5 2.5 {name=VCTRL dir=out}
L 4 60 0 80 0 {}
T {VCTRL} 55 -4 0 1 0.2 0.2 {}
B 5 -22.5 -82.5 -17.5 -77.5 {name=VDD dir=inout}
L 7 -20 -80 -20 -60 {}
B 5 17.5 77.5 22.5 82.5 {name=VSS dir=inout}
L 7 20 60 20 80 {}
