v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -42 -6 0 0 0.3 0.3 {}
T {@name} 55 -52 0 0 0.2 0.2 {}
P 4 5 50 -40 -50 -40 -50 40 50 40 50 -40 {}
B 5 -72.5 -2.5 -67.5 2.5 {name=VCO_IN dir=in}
L 4 -70 0 -50 0 {}
T {VCO} -45 -4 0 0 0.2 0.2 {}
B 5 67.5 -22.5 72.5 -17.5 {name=PLL_CLK dir=out}
L 4 50 -20 70 -20 {}
T {PLL} 45 -24 0 1 0.2 0.2 {}
B 5 67.5 17.5 72.5 22.5 {name=TEST_CLK dir=out}
L 4 50 20 70 20 {}
T {TEST} 45 16 0 1 0.2 0.2 {}
