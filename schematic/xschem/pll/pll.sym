v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -42 -6 0 0 0.3 0.3 {}
T {@name} 85 -92 0 0 0.2 0.2 {}
P 4 5 80 -80 -80 -80 -80 80 80 80 80 -80 {}
B 5 -102.5 -62.5 -97.5 -57.5 {name=REF_CLK dir=in}
L 4 -100 -60 -80 -60 {}
T {REF_CLK} -75 -64 0 0 0.2 0.2 {}
B 5 -102.5 -42.5 -97.5 -37.5 {name=IREF dir=inout}
L 4 -100 -40 -80 -40 {}
T {IREF} -75 -44 0 0 0.2 0.2 {}
B 5 -102.5 -22.5 -97.5 -17.5 {name=ENABLE dir=in}
L 4 -100 -20 -80 -20 {}
T {ENABLE} -75 -24 0 0 0.2 0.2 {}
B 5 -102.5 -2.5 -97.5 2.5 {name=RESET_N dir=in}
L 4 -100 0 -80 0 {}
T {RESET_N} -75 -4 0 0 0.2 0.2 {}
B 5 -102.5 17.5 -97.5 22.5 {name=DIV_INT[6:0] dir=in}
L 4 -100 20 -80 20 {}
T {DIV_INT[6:0]} -75 16 0 0 0.2 0.2 {}
B 5 -102.5 37.5 -97.5 42.5 {name=DIV_FRAC[15:0] dir=in}
L 4 -100 40 -80 40 {}
T {DIV_FRAC[15:0]} -75 36 0 0 0.2 0.2 {}
B 5 -102.5 57.5 -97.5 62.5 {name=TEST_DIV[1:0] dir=in}
L 4 -100 60 -80 60 {}
T {TEST_DIV[1:0]} -75 56 0 0 0.2 0.2 {}
B 5 97.5 -22.5 102.5 -17.5 {name=PLL_CLK dir=out}
L 4 80 -20 100 -20 {}
T {PLL_CLK} 75 -24 0 1 0.2 0.2 {}
B 5 97.5 17.5 102.5 22.5 {name=TEST_CLK dir=out}
L 4 80 20 100 20 {}
T {TEST_CLK} 75 16 0 1 0.2 0.2 {}
B 5 -22.5 -102.5 -17.5 -97.5 {name=VDD dir=inout}
L 7 -20 -100 -20 -80 {}
B 5 17.5 97.5 22.5 102.5 {name=VSS dir=inout}
L 7 20 80 20 100 {}
