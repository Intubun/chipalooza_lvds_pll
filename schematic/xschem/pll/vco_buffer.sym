v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -42 -6 0 0 0.3 0.3 {}
T {@name} 55 -62 0 0 0.2 0.2 {}
P 4 5 50 -50 -50 -50 -50 50 50 50 50 -50 {}
B 5 -72.5 -2.5 -67.5 2.5 {name=VIN dir=in}
L 4 -70 0 -50 0 {}
T {VIN} -45 -4 0 0 0.2 0.2 {}
B 5 67.5 -2.5 72.5 2.5 {name=VOUT dir=out}
L 4 50 0 70 0 {}
T {VOUT} 45 -4 0 1 0.2 0.2 {}
B 5 -2.5 -72.5 2.5 -67.5 {name=VDD dir=inout}
L 7 0 -70 0 -50 {}
T {VDD} -4 -45 3 0 0.2 0.2 {}
B 5 -2.5 67.5 2.5 72.5 {name=VSS dir=inout}
L 7 0 50 0 70 {}
T {VSS} -4 45 1 1 0.2 0.2 {}
